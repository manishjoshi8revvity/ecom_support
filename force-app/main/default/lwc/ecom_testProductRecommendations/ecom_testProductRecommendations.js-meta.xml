<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <isExposed>true</isExposed>

    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightningCommunity__Default">
            <property name="recencyFactor" type="String" label="Recency factor (T)" required="true" />
            <property name="steepnessFactor" type="String" label="Steepness factor (k)"
                required="true" />
            <property name="maxRecs" type="Integer" label="Max Recommendations Count to Emit"
                required="true" />
            <property name="samplesetSize" type="Integer" label="Sample set size" required="true" />
            <property name="sameOrderBoost" type="Integer" label="Same order boost (SOB)"
                required="true" />
            <property name="disableMultiProductSOB" type="Boolean" label="Disable multi-product SOB" />
            <property name="startDate" type="String" label="Start date" />
            <property name="endDate" type="String" label="End date" />

            <property type="String" name="sourceDataset" label="Source dataset" datasource="web,sap" />
            <property type="Boolean" name="hideUI" label="Hide UI" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>